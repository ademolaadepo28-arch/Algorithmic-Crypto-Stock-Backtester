# Express Server Port
PORT=10000

# Node Environment
NODE_ENV=development

# Redis Connection String (Optional - In-Memory LRU fallback will be used if omitted)
# REDIS_URL=rediss://default:password@your-upstash-instance.upstash.io:6379
# REDIS_URL=redis://localhost:6379

# Alpha Vantage API Key (Optional - seeded high-fidelity historical data fallback used if omitted)
# ALPHA_VANTAGE_KEY=your_alpha_vantage_key_here
